---
import ToolLayout from '../../layouts/ToolLayout.astro';
const { title, description, canonicalPath, toolName, toolTagline, seoKeywords, faqs } = Astro.props;

const howToSteps = [
  { name: "Upload your PDF", text: "Select or drag-and-drop the PDF file you want to compress. The original size is displayed instantly." },
  { name: "Choose a Mode", text: "Select 'Standard' to preserve text quality, or 'Extreme' to hit a strict target file size by flattening the document." },
  { name: "Compress & Download", text: "Set your desired compression level or target size and click Compress. The optimized PDF is generated instantly in your browser." },
];
---

<ToolLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  toolName={toolName}
  toolTagline={toolTagline}
  category="pdf"
  categoryLabel="PDF Tools"
  categoryHref="/#category-pdf"
  seoKeywords={seoKeywords}
  faqs={faqs}
  howToSteps={howToSteps}
>
  <div slot="drop-zone">
    <!-- Upload Area -->
    <div class="drop-zone" id="drop-zone" role="button" tabindex="0">
      <svg class="drop-zone__icon" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
      </svg>
      <span class="drop-zone__text">Click to select or drop a PDF here</span>
      <span class="drop-zone__hint">Up to 100MB</span>
      <input type="file" id="file-input" accept="application/pdf" class="sr-only" aria-label="Select PDF" />
    </div>
  </div>

  <div slot="options">
    <!-- Main Workspace -->
    <div id="file-info" style="display:none; flex-direction:column; gap:var(--space-5); margin-bottom:var(--space-6);">
      
      <div style="display:flex; flex-wrap:wrap; gap:var(--space-5);">
        
        <!-- Controls Column -->
        <div style="flex:1; min-width:300px; background:var(--color-canvas-soft); border:1px solid var(--color-border-hairline); border-radius:var(--radius-lg); padding:var(--space-5);">
          
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:var(--space-4);">
            <h3 style="margin:0; font-size:1.125rem; font-weight:600;">File Selected</h3>
            <button class="btn btn-ghost" id="clear-btn" style="height:32px; padding:0 var(--space-3); font-size:0.875rem;">Clear</button>
          </div>
          <p id="file-name" style="margin:0 0 var(--space-1) 0; font-weight:500; word-break:break-all;"></p>
          <p id="file-size" style="margin:0 0 var(--space-5) 0; font-size:0.875rem; color:var(--color-ink-muted);"></p>

          <hr style="border:none; border-top:1px solid var(--color-border-hairline); margin-bottom:var(--space-5);" />
          
          <h3 style="margin:0 0 var(--space-3) 0; font-size:1rem; font-weight:600;">1. Select Mode</h3>
          
          <!-- Mode Toggles -->
          <div style="display:flex; flex-direction:column; gap:var(--space-3); margin-bottom:var(--space-5);">
            <label style="display:flex; align-items:flex-start; gap:var(--space-3); padding:var(--space-3); border:1px solid var(--color-accent-blue); border-radius:var(--radius-md); background:var(--color-info-bg); cursor:pointer;">
              <input type="radio" name="compress-mode" value="standard" checked style="margin-top:4px;" />
              <div>
                <strong style="display:block; color:var(--color-ink-primary);">Standard (Preserve Text)</strong>
                <span style="font-size:0.8125rem; color:var(--color-ink-muted);">Shrinks embedded images but perfectly preserves vector text and layout. Best for standard documents.</span>
              </div>
            </label>
            
            <label style="display:flex; align-items:flex-start; gap:var(--space-3); padding:var(--space-3); border:1px solid var(--color-border-subtle); border-radius:var(--radius-md); cursor:pointer;">
              <input type="radio" name="compress-mode" value="extreme" style="margin-top:4px;" />
              <div>
                <strong style="display:block; color:var(--color-ink-primary);">Extreme (Scanned / Target Size)</strong>
                <span style="font-size:0.8125rem; color:var(--color-ink-muted);">Flattens all pages to hit an exact KB size limit. Best for uploading scans to strict portals.</span>
              </div>
            </label>
          </div>

          <hr style="border:none; border-top:1px solid var(--color-border-hairline); margin-bottom:var(--space-5);" />
          
          <h3 style="margin:0 0 var(--space-3) 0; font-size:1rem; font-weight:600;">2. Settings</h3>

          <!-- Standard Settings -->
          <div id="settings-standard" style="display:block; margin-bottom:var(--space-5);">
            <label for="standard-level" style="display:block; font-size:0.875rem; font-weight:500; margin-bottom:var(--space-2);">Compression Preset</label>
            <select id="standard-level" class="input" style="width:100%; height:38px; cursor:pointer;">
              <option value="balanced" selected>Balanced (Good quality, medium size)</option>
              <option value="max">Maximum (Lower quality, smallest size)</option>
              <option value="lossless">Lossless (Best quality, minor size reduction)</option>
            </select>
          </div>

          <!-- Extreme Settings -->
          <div id="settings-extreme" style="display:none; margin-bottom:var(--space-5);">
             <label for="target-size-input" style="display:block; font-size:0.875rem; font-weight:500; margin-bottom:var(--space-2);">Target Size (KB)</label>
             <div style="display:flex; align-items:center; gap:var(--space-3);">
                <input type="number" id="target-size-input" class="input" placeholder="e.g. 100" style="flex:1; height:38px;" />
                <span style="color:var(--color-ink-muted); font-size:0.875rem;">KB</span>
             </div>
             <p style="font-size:0.75rem; color:var(--color-warning-text); margin-top:var(--space-2);">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:inline-block; vertical-align:middle;"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                Warning: Text will become an image.
             </p>
          </div>

          <button class="btn btn-secondary" id="compress-btn" style="width:100%; height:44px; font-weight:600;">Compress PDF</button>

        </div>

        <!-- Result Column -->
        <div style="flex:1; min-width:300px; display:flex; flex-direction:column; align-items:center; justify-content:center; background:var(--color-canvas-soft); border:1px solid var(--color-border-hairline); border-radius:var(--radius-lg); padding:var(--space-5); text-align:center;">
          
          <div id="result-empty" style="display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:400px; height:100%;">
             <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-border-subtle)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom:var(--space-4);"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
             <p style="color:var(--color-ink-muted); margin:0;">Upload a PDF to see the preview.</p>
          </div>

          <div id="pdf-preview-workspace" style="display:none; flex-direction:column; width:100%;">
            
             <!-- Preview Canvas -->
             <div style="width:100%; aspect-ratio:1/1.4; background:#fff; border:1px solid var(--color-border-subtle); border-radius:var(--radius-md); overflow:hidden; position:relative; margin-bottom:var(--space-4);">
               <canvas id="pdf-preview-canvas" style="width:100%; height:100%; object-fit:contain; transition: filter 0.4s ease, opacity 0.4s ease;"></canvas>
               <div id="pdf-preview-loading" style="display:none; position:absolute; inset:0; background:rgba(255,255,255,0.8); align-items:center; justify-content:center; font-weight:600; color:var(--color-ink-primary);">Loading page...</div>
               
               <!-- Controls -->
               <div style="position:absolute; bottom:12px; left:50%; transform:translateX(-50%); display:flex; align-items:center; gap:16px; background:rgba(0,0,0,0.8); padding:6px 16px; border-radius:100px; box-shadow:var(--shadow-md);">
                 <button id="prev-page-btn" style="color:white; background:none; border:none; cursor:pointer; font-size:18px; line-height:1; padding:0; display:flex;">&lt;</button>
                 <span id="page-indicator" style="color:white; font-size:14px; font-weight:500; min-width:40px; text-align:center;">1 / 1</span>
                 <button id="next-page-btn" style="color:white; background:none; border:none; cursor:pointer; font-size:18px; line-height:1; padding:0; display:flex;">&gt;</button>
               </div>
               
               <!-- Compression Progress Overlay -->
               <div id="calc-progress-container" style="display:none; position:absolute; inset:0; background:rgba(255,255,255,0.4); flex-direction:column; align-items:center; justify-content:center; padding:var(--space-5);">
                 <div style="width:100%; max-width:400px; background:var(--color-canvas-base); border:1px solid var(--color-border-subtle); border-radius:var(--radius-lg); padding:var(--space-4); box-shadow:var(--shadow-lg); text-align:center;">
                   <h3 style="margin:0 0 var(--space-3) 0; font-size:1.1rem; font-weight:600; color:var(--color-ink-primary);">Compressing PDF...</h3>
                   <div style="width:100%; height:12px; background:var(--color-border-hairline); border-radius:6px; overflow:hidden;">
                     <div id="calc-progress-bar" style="width:0%; height:100%; background:var(--color-brand-primary); transition:width 0.2s ease; border-radius:6px;"></div>
                   </div>
                   <p id="calc-progress-text" style="font-size:0.875rem; color:var(--color-ink-muted); margin:0; margin-top:var(--space-3);">Initializing...</p>
                 </div>
               </div>
             </div>

             <!-- Compression Stats -->
             <div id="result-success" style="display:none; flex-direction:column; align-items:center; width:100%; background:var(--color-success-bg); border:1px solid rgba(15, 123, 63, 0.2); border-radius:var(--radius-md); padding:var(--space-4); margin-bottom:var(--space-4);">
                <h3 style="margin:0 0 var(--space-3) 0; font-size:1.125rem; font-weight:600; color:var(--color-success-text);">Compression Complete!</h3>
                <div style="display:flex; gap:var(--space-4); margin-bottom:var(--space-3);">
                   <div style="text-align:center;">
                      <span style="display:block; font-size:0.65rem; color:var(--color-ink-muted); text-transform:uppercase;">Original</span>
                      <strong id="result-orig-size" style="font-size:1rem; color:var(--color-ink-primary);">--</strong>
                   </div>
                   <div style="text-align:center; padding-top:4px;">
                      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--color-ink-faint);"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                   </div>
                   <div style="text-align:center;">
                      <span style="display:block; font-size:0.65rem; color:var(--color-accent-green); text-transform:uppercase;">Compressed</span>
                      <strong id="result-new-size" style="font-size:1rem; color:var(--color-success-text);">--</strong>
                   </div>
                </div>
                <div id="savings-badge" style="display:inline-block; padding:2px 10px; background:rgba(15, 123, 63, 0.1); color:var(--color-success-text); border-radius:100px; font-weight:600; font-size:0.75rem;">Saved --%</div>
             </div>

             <button class="btn btn-primary btn-lg" id="download-btn" style="width:100%; display:none;">
               <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
               Download PDF
             </button>
             
          </div>

        </div>

      </div>
    </div>
  </div>
</ToolLayout>

<script>
  import { compress } from '@quicktoolsone/pdf-compress';
  
  // Elements
  const dropZone = document.getElementById('drop-zone') as HTMLElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileInfo = document.getElementById('file-info') as HTMLElement;
  const fileNameEl = document.getElementById('file-name') as HTMLElement;
  const fileSizeEl = document.getElementById('file-size') as HTMLElement;
  const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
  
  const modeRadios = document.querySelectorAll('input[name="compress-mode"]');
  const settingsStandard = document.getElementById('settings-standard') as HTMLElement;
  const settingsExtreme = document.getElementById('settings-extreme') as HTMLElement;
  
  const compressBtn = document.getElementById('compress-btn') as HTMLButtonElement;
  const downloadBtn = document.getElementById('download-btn') as HTMLButtonElement;
  
  const resultEmpty = document.getElementById('result-empty') as HTMLElement;
  const resultSuccess = document.getElementById('result-success') as HTMLElement;
  const resultOrigSize = document.getElementById('result-orig-size') as HTMLElement;
  const resultNewSize = document.getElementById('result-new-size') as HTMLElement;
  const savingsBadge = document.getElementById('savings-badge') as HTMLElement;
  
  const progressContainer = document.getElementById('calc-progress-container') as HTMLElement;
  const progressBar = document.getElementById('calc-progress-bar') as HTMLElement;
  const progressText = document.getElementById('calc-progress-text') as HTMLElement;
  
  const previewWorkspace = document.getElementById('pdf-preview-workspace') as HTMLElement;
  const previewCanvas = document.getElementById('pdf-preview-canvas') as HTMLCanvasElement;
  const previewLoading = document.getElementById('pdf-preview-loading') as HTMLElement;
  const pageIndicator = document.getElementById('page-indicator') as HTMLElement;
  const prevPageBtn = document.getElementById('prev-page-btn') as HTMLButtonElement;
  const nextPageBtn = document.getElementById('next-page-btn') as HTMLButtonElement;
  
  let currentFile: File | null = null;
  let compressedBlobUrl: string | null = null;
  let compressedBlobCache: Blob | null = null;

  // Preview State
  let pdfPreviewDoc: any = null;
  let pdfPreviewNumPages = 0;
  let currentPreviewPage = 1;
  
  function fmt(b: number) {
    if (b < 1024) return b + ' B';
    if (b < 1048576) return (b / 1024).toFixed(1) + ' KB';
    return (b / 1048576).toFixed(2) + ' MB';
  }

  // File Upload
  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drop-zone--active'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drop-zone--active'));
  dropZone.addEventListener('drop', (e) => { 
    e.preventDefault(); 
    dropZone.classList.remove('drop-zone--active'); 
    if (e.dataTransfer?.files?.[0]) handleFile(e.dataTransfer.files[0]);
  });
  fileInput.addEventListener('change', () => {
    if (fileInput.files?.[0]) handleFile(fileInput.files[0]);
  });

  async function handleFile(file: File) {
    if (!file.type.includes('pdf')) {
      (window as any).showToast('Please upload a PDF file.', 'error');
      return;
    }
    // Magic-byte validation (%PDF-)
    const hdr = new Uint8Array(await file.slice(0, 5).arrayBuffer());
    if (hdr[0] !== 0x25 || hdr[1] !== 0x50 || hdr[2] !== 0x44 || hdr[3] !== 0x46) {
      (window as any).showToast('This file does not appear to be a valid PDF.', 'error');
      return;
    }
    currentFile = file;
    fileNameEl.textContent = file.name;
    fileSizeEl.textContent = fmt(file.size);
    
    dropZone.style.display = 'none';
    fileInfo.style.display = 'flex';
    
    resultEmpty.style.display = 'none';
    previewWorkspace.style.display = 'flex';
    resultSuccess.style.display = 'none';
    downloadBtn.style.display = 'none';
    
    if (compressedBlobUrl) URL.revokeObjectURL(compressedBlobUrl);
    compressedBlobUrl = null;
    compressedBlobCache = null;
    
    pdfPreviewDoc = null;
    await renderPreview(file, 1);
  }

  async function renderPreview(file: File, pageNum: number) {
    previewLoading.style.display = 'flex';
    try {
      if (!pdfPreviewDoc) {
        const arrayBuffer = await file.arrayBuffer();
        const pdfjsLib = await import('pdfjs-dist');
        pdfjsLib.GlobalWorkerOptions.workerSrc = `${((import.meta as any).env.BASE_URL || "/").replace(/\/$/, "")}/pdfjs/pdf.worker.min.mjs`;
        const loadingTask = pdfjsLib.getDocument({ data: new Uint8Array(arrayBuffer) });
        pdfPreviewDoc = await loadingTask.promise;
        pdfPreviewNumPages = pdfPreviewDoc.numPages;
      }
      
      currentPreviewPage = pageNum;
      pageIndicator.textContent = `${currentPreviewPage} / ${pdfPreviewNumPages}`;
      
      const page = await pdfPreviewDoc.getPage(pageNum);
      const viewport = page.getViewport({ scale: 1.5 }); // Crisp rendering
      
      previewCanvas.width = viewport.width;
      previewCanvas.height = viewport.height;
      const ctx = previewCanvas.getContext('2d')!;
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, previewCanvas.width, previewCanvas.height);
      
      await page.render({ canvasContext: ctx, viewport }).promise;
    } catch(e: any) {
      console.error(e);
      alert('PdfCompress Error: ' + (e.message || e));
    } finally {
      previewLoading.style.display = 'none';
    }
  }

  prevPageBtn.addEventListener('click', async () => {
    if (currentPreviewPage > 1) {
      const fileToRender = compressedBlobCache ? new File([compressedBlobCache], 'c.pdf') : currentFile;
      if (fileToRender) renderPreview(fileToRender, currentPreviewPage - 1);
    }
  });
  nextPageBtn.addEventListener('click', async () => {
    if (currentPreviewPage < pdfPreviewNumPages) {
      const fileToRender = compressedBlobCache ? new File([compressedBlobCache], 'c.pdf') : currentFile;
      if (fileToRender) renderPreview(fileToRender, currentPreviewPage + 1);
    }
  });
  
  clearBtn.addEventListener('click', () => {
    currentFile = null;
    fileInput.value = '';
    fileInfo.style.display = 'none';
    dropZone.style.display = 'flex';
    
    pdfPreviewDoc = null;
    previewWorkspace.style.display = 'none';
    resultEmpty.style.display = 'flex';
    resultSuccess.style.display = 'none';
    downloadBtn.style.display = 'none';
    
    if (compressedBlobUrl) { URL.revokeObjectURL(compressedBlobUrl); compressedBlobUrl = null; }
    compressedBlobCache = null;
  });
  
  // Mode Toggle UI
  modeRadios.forEach(radio => {
    radio.addEventListener('change', (e) => {
      const val = (e.target as HTMLInputElement).value;
      
      // Reset borders
      modeRadios.forEach(r => {
         const parent = r.parentElement;
         if (parent) {
            parent.style.borderColor = 'var(--color-border-subtle)';
            parent.style.background = 'transparent';
         }
      });
      // Highlight selected
      const selectedParent = (e.target as HTMLInputElement).parentElement;
      if (selectedParent) {
         selectedParent.style.borderColor = 'var(--color-accent-blue)';
         selectedParent.style.background = 'var(--color-info-bg)';
      }
      
      if (val === 'standard') {
        settingsStandard.style.display = 'block';
        settingsExtreme.style.display = 'none';
      } else {
        settingsStandard.style.display = 'none';
        settingsExtreme.style.display = 'block';
      }
    });
  });

  // Compress Action
  compressBtn.addEventListener('click', async () => {
    if (!currentFile) return;
    
    const mode = (document.querySelector('input[name="compress-mode"]:checked') as HTMLInputElement).value;
    
    // UI Setup
    compressBtn.disabled = true;
    const oldText = compressBtn.textContent;
    compressBtn.textContent = 'Compressing...';
    
    progressContainer.style.display = 'flex';
    progressBar.style.width = '0%';
    progressText.textContent = 'Initializing...';
    
    previewCanvas.style.filter = 'blur(6px) grayscale(50%)';
    previewCanvas.style.opacity = '0.5';
    previewWorkspace.style.pointerEvents = 'none';
    
    resultEmpty.style.display = 'none';
    resultSuccess.style.display = 'none';
    downloadBtn.style.display = 'none';
    
    await new Promise(r => setTimeout(r, 50));
    
    try {
      let compressedBytes: Uint8Array;
      
      if (mode === 'standard') {
         progressText.textContent = 'Processing PDF...';
         progressBar.style.width = '0%';
         
         const preset = (document.getElementById('standard-level') as HTMLSelectElement).value;
         const arrayBuffer = await currentFile.arrayBuffer();
         
         // Using standard compression library
         const result = await compress(arrayBuffer, {
            preset: preset as any,
            onProgress: (p) => {
               progressBar.style.width = `${p.progress}%`;
               progressText.textContent = `Processing (${Math.round(p.progress)}%)`;
            }
         });
         compressedBytes = new Uint8Array(result.pdf);
         
      } else {
        // ── Extreme Mode: stream-render pages → transfer RGBA buffers to worker ──
        progressText.textContent = 'Loading PDF engine…';
        const targetKB = Number((document.getElementById('target-size-input') as HTMLInputElement).value);
        if (!targetKB || targetKB <= 0) throw new Error('Please enter a valid target size (KB).');
        const targetBytes = targetKB * 1024;

        const arrayBuffer = await currentFile.arrayBuffer();
        const pdfjsLib = await import('pdfjs-dist');
        pdfjsLib.GlobalWorkerOptions.workerSrc = `${((import.meta as any).env.BASE_URL || "/").replace(/\/$/, "")}/pdfjs/pdf.worker.min.mjs`;

        const pdf = await pdfjsLib.getDocument({ data: new Uint8Array(arrayBuffer) }).promise;
        const numPages = pdf.numPages;
        
        // Dynamically adjust scale to preserve readability at tiny sizes
        const targetKBPerPage = targetKB / numPages;
        let renderScale = 2.0;
        if (targetKBPerPage < 30) renderScale = 0.75; // Ultra low target: reduce resolution to save quality
        else if (targetKBPerPage < 75) renderScale = 1.0;
        else if (targetKBPerPage < 150) renderScale = 1.5;

        progressText.textContent = `Rasterising ${numPages} pages (streaming at ${renderScale}x)…`;

        // Render ONE PAGE AT A TIME and immediately transfer RGBA to worker.
        // Peak main-thread RAM: ~8 MB (one canvas) vs old ~800 MB (all pages).
        const pageRGBABuffers: ArrayBuffer[] = [];
        const widths: number[] = [];
        const heights: number[] = [];

        for (let i = 1; i <= numPages; i++) {
          progressBar.style.width = `${(i / numPages) * 25}%`;
          progressText.textContent = `Rasterising page ${i} / ${numPages}…`;
          await new Promise(r => setTimeout(r, 0)); // yield for paint

          const page = await pdf.getPage(i);
          const viewport = page.getViewport({ scale: renderScale });
          const canvas = document.createElement('canvas');
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          const ctx = canvas.getContext('2d', { willReadFrequently: true })!;
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          await page.render({ canvasContext: ctx, viewport }).promise;

          const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
          widths.push(canvas.width);
          heights.push(canvas.height);
          pageRGBABuffers.push(imgData.data.buffer); // take ownership
          canvas.width = 0; canvas.height = 0; // release GPU memory immediately
        }

        progressText.textContent = 'Searching optimal quality in worker…';
        progressBar.style.width = '28%';

        compressedBytes = await new Promise<Uint8Array>((resolve, reject) => {
          const worker = new Worker(
            new URL('../../workers/pdfCompressWorker.ts', import.meta.url),
            { type: 'module' }
          );
          worker.onmessage = async (ev) => {
            const { type: t, payload: p } = ev.data;
            if (t === 'PROGRESS') {
              progressBar.style.width = `${28 + p.progress * 0.6}%`;
              progressText.textContent = p.text;
            } else if (t === 'WARNING') {
              (window as any).showToast(p.message, 'error');
            } else if (t === 'SUCCESS') {
              worker.terminate();
              progressText.textContent = 'Rebuilding PDF…';
              progressBar.style.width = '90%';
              try {
                const { PDFDocument } = await import('pdf-lib');
                const newPdf = await PDFDocument.create();
                for (let i = 0; i < p.jpegs.length; i++) {
                  const emb = await newPdf.embedJpg(new Uint8Array(p.jpegs[i] as ArrayBuffer));
                  const pg = newPdf.addPage([widths[i] / renderScale, heights[i] / renderScale]);
                  pg.drawImage(emb, { x: 0, y: 0, width: widths[i] / renderScale, height: heights[i] / renderScale });
                }
                resolve(await newPdf.save());
              } catch (e) { reject(e); }
            } else if (t === 'ERROR') {
              worker.terminate(); reject(new Error(p.error));
            }
          };
          worker.onerror = (ev) => { worker.terminate(); reject(new Error(ev.message)); };
          // Transfer ownership of RGBA buffers — zero-copy
          worker.postMessage(
            { type: 'COMPRESS_EXTREME', payload: { pageRGBABuffers, widths, heights, targetBytes } },
            pageRGBABuffers
          );
        });
      }
      
      progressBar.style.width = '100%';
      progressText.textContent = 'Finalizing...';
      
      const newBlob = new Blob([compressedBytes], { type: 'application/pdf' });
      
      if (compressedBlobUrl) URL.revokeObjectURL(compressedBlobUrl);
      compressedBlobCache = newBlob;
      compressedBlobUrl = URL.createObjectURL(newBlob);
      
      // Update UI with results
      resultOrigSize.textContent = fmt(currentFile.size);
      resultNewSize.textContent = fmt(newBlob.size);
      
      const savedPct = Math.max(0, Math.round((1 - newBlob.size / currentFile.size) * 100));
      savingsBadge.textContent = `Saved ${savedPct}%`;
      if (savedPct === 0) savingsBadge.textContent = `No savings`;
      
      setTimeout(async () => {
         progressContainer.style.display = 'none';
         
         previewCanvas.style.filter = 'none';
         previewCanvas.style.opacity = '1';
         previewWorkspace.style.pointerEvents = 'auto';
         
         resultSuccess.style.display = 'flex';
         downloadBtn.style.display = 'flex';
         
         // Reload preview with the compressed PDF so the user sees the visual difference
         try {
            pdfPreviewDoc = null;
            const compressedFile = new File([newBlob], "compressed.pdf");
            await renderPreview(compressedFile, Math.min(currentPreviewPage, pdfPreviewNumPages));
         } catch (e) {
            console.error("Failed to render compressed preview", e);
         }
      }, 500);

    } catch (err: any) {
      console.error(err);
      (window as any).showToast(err.message || 'Compression failed', 'error');
      progressContainer.style.display = 'none';
    } finally {
      previewCanvas.style.filter = 'none';
      previewCanvas.style.opacity = '1';
      previewWorkspace.style.pointerEvents = 'auto';
      
      compressBtn.disabled = false;
      compressBtn.textContent = oldText;
    }
  });
  
  downloadBtn.addEventListener('click', () => {
    if (!compressedBlobUrl || !currentFile) return;
    const a = document.createElement('a');
    a.href = compressedBlobUrl;
    a.download = currentFile.name.replace('.pdf', '_compressed.pdf');
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
  });
  
</script>
