---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAssetPath } from '../utils/paths';

interface Props {
  error: unknown;
}

const { error } = Astro.props;
---

<BaseLayout title="Server Error | DocuVerse" noIndex={true}>
  <div class="error-page">
    <div class="error-page__content">
      <div class="error-page__icon error-page__icon--red">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      </div>
      <h1 class="error-page__title">500</h1>
      <h2 class="error-page__subtitle">Internal Server Error</h2>
      <p class="error-page__desc">Something went wrong on our end. We're looking into it.</p>
      
      {error && (
        <div class="error-page__details">
          <p>{error instanceof Error ? error.message : 'Unknown Error'}</p>
        </div>
      )}
      
      <div class="error-page__actions">
        <button class="btn btn-primary btn-lg" onclick="window.location.reload()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          Try Again
        </button>
        <a href={getAssetPath("/")} class="btn btn-ghost btn-lg">
          Go to Homepage
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page {
    min-height: calc(100vh - 160px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-8) var(--space-4);
    background: radial-gradient(circle at center, var(--color-canvas-soft) 0%, var(--color-canvas-base) 100%);
  }
  .error-page__content {
    text-align: center;
    max-width: 480px;
    animation: fade-in-up var(--duration-normal) var(--ease-out);
  }
  .error-page__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-6);
  }
  .error-page__icon--red {
    background: rgba(220, 38, 38, 0.08);
    color: #dc2626;
  }
  .error-page__title {
    font-size: 5rem;
    font-weight: 900;
    line-height: 1;
    color: var(--color-ink-primary);
    margin-bottom: var(--space-2);
    letter-spacing: -0.04em;
  }
  .error-page__subtitle {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-ink-secondary);
    margin-bottom: var(--space-4);
  }
  .error-page__desc {
    font-size: 1.125rem;
    color: var(--color-ink-muted);
    margin-bottom: var(--space-6);
    line-height: 1.6;
  }
  .error-page__details {
    background: rgba(0,0,0,0.03);
    padding: var(--space-4);
    border-radius: var(--radius-md);
    font-family: monospace;
    font-size: 0.8125rem;
    color: var(--color-ink-secondary);
    margin-bottom: var(--space-6);
    text-align: left;
    overflow-x: auto;
  }
  .error-page__actions {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
  }
</style>
