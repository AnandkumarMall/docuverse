---
import ToolLayout from '../../layouts/ToolLayout.astro';

const howToSteps = [
  { name: "Upload your PDF", text: "Drop or select the PDF you want to password-protect." },
  { name: "Set a password", text: "Enter the password twice to confirm. Choose something strong — you'll need this password to open the file." },
  { name: "Protect and Download", text: "Click 'Protect PDF'. Your browser encrypts the file using AES-128. Download the protected PDF — no server involved." },
];
const faqs = [
  { question: "Is encryption done on a server?", answer: "No. The PDF is encrypted entirely in your browser. Your file and your password never leave your device." },
  { question: "What encryption standard is used?", answer: "pdf-lib uses AES-128 PDF standard encryption, which is compatible with Adobe Acrobat and all major PDF viewers." },
  { question: "What if I forget the password?", answer: "There is no recovery option. Make sure you save the password securely. You can use our Unlock PDF tool if you know the password but want to remove it." },
];
---

<ToolLayout
  title="Protect PDF with Password — Free, Private, Online"
  description="Add AES password protection to any PDF. Free and 100% private — encryption runs in your browser, your file is never uploaded."
  canonicalPath="/pdf/protect"
  toolName="Protect PDF"
  toolTagline="Add password encryption to your PDF — free, private, browser-only."
  category="pdf"
  categoryLabel="PDF Tools"
  categoryHref="/#category-pdf"
  acceptedFormats="One PDF file · No size limit"
  howToSteps={howToSteps}
  faqs={faqs}
>

  <div slot="drop-zone">
    <div class="drop-zone" id="drop-zone" role="button" tabindex="0" aria-label="Drop a PDF here or click to browse">
      <svg class="drop-zone__icon" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      <span class="drop-zone__text">Drop a PDF here or click to browse</span>
      <span class="drop-zone__hint">One PDF · No size limit · Files stay on your device</span>
      <input type="file" id="file-input" accept=".pdf,application/pdf" class="sr-only" />
    </div>
  </div>

  <div slot="file-list">
    <div id="file-info" style="display:none;" class="prot-file-info">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent-orange)" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      <span id="file-name" class="prot-file-info__name"></span>
      <span id="file-size" class="prot-file-info__size"></span>
      <button class="file-item__remove" id="remove-file"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
  </div>

  <div slot="options">
    <div id="prot-options" style="display:none;" class="prot-options">
      <div class="prot-field">
        <label for="pwd1" class="prot-label">Password</label>
        <div class="prot-input-wrap">
          <input type="password" id="pwd1" class="input" placeholder="Enter password" autocomplete="new-password" />
          <button type="button" class="prot-show-btn" id="show1" aria-label="Show password">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>
      <div class="prot-field">
        <label for="pwd2" class="prot-label">Confirm Password</label>
        <div class="prot-input-wrap">
          <input type="password" id="pwd2" class="input" placeholder="Re-enter password" autocomplete="new-password" />
          <button type="button" class="prot-show-btn" id="show2" aria-label="Show confirm password">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
        <p id="pwd-error" class="prot-error" style="display:none;" role="alert">Passwords do not match.</p>
      </div>
    </div>
  </div>

  <div slot="actions" class="prot-actions" id="prot-actions" style="display:none;">
    <button class="btn btn-primary btn-lg" id="prot-btn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
      Protect PDF
    </button>
    <button class="btn btn-ghost" id="clear-btn">Clear</button>
  </div>

  <div slot="result">
    <div id="prot-result" style="display:none;" aria-live="assertive" class="prot-result">
      <div class="prot-result__icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg></div>
      <div><p class="prot-result__label">PDF protected!</p><p class="prot-result__sub">Keep your password safe — it cannot be recovered.</p></div>
      <a class="btn btn-accent" id="download-btn" download="protected.pdf">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download Protected PDF
      </a>
      <button class="btn btn-ghost btn-sm" id="restart-btn">Protect another</button>
    </div>
  </div>
</ToolLayout>

<style>
  .prot-file-info { display:flex; align-items:center; gap:var(--space-3); padding:var(--space-3) var(--space-4); background:var(--color-canvas-soft); border:1px solid var(--color-border-hairline); border-radius:var(--radius-md); }
  .prot-file-info__name { flex:1; font-size:.9375rem; font-weight:500; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--color-ink-primary); }
  .prot-file-info__size { font-size:.8125rem; color:var(--color-ink-faint); white-space:nowrap; }
  .prot-options { display:flex; flex-direction:column; gap:var(--space-5); max-width:420px; }
  .prot-field { display:flex; flex-direction:column; gap:var(--space-2); }
  .prot-label { font-size:.9375rem; font-weight:500; color:var(--color-ink-primary); }
  .prot-input-wrap { position:relative; display:flex; align-items:center; }
  .prot-input-wrap .input { padding-right:var(--space-10); }
  .prot-show-btn { position:absolute; right:var(--space-3); background:none; border:none; cursor:pointer; color:var(--color-ink-faint); display:flex; align-items:center; justify-content:center; width:32px; height:32px; border-radius:var(--radius-sm); transition:color var(--duration-fast); }
  .prot-show-btn:hover { color:var(--color-ink-secondary); }
  .prot-error { font-size:.875rem; color:var(--color-accent-red); margin-top:var(--space-1); }
  .prot-actions { display:flex; align-items:center; gap:var(--space-4); }
  .prot-result { display:flex; align-items:center; gap:var(--space-5); padding:var(--space-5) var(--space-6); background:var(--color-success-bg); border:1px solid rgba(15,123,63,.2); border-radius:var(--radius-lg); flex-wrap:wrap; animation:fade-in-up var(--duration-slow) var(--ease-out); }
  .prot-result__icon { width:52px; height:52px; border-radius:var(--radius-pill); background:var(--color-accent-green); color:#fff; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .prot-result__label { font-size:1rem; font-weight:600; color:var(--color-accent-green); }
  .prot-result__sub { font-size:.8125rem; color:var(--color-ink-muted); margin-top:2px; }
</style>

<script>
  import { PDFDocument } from 'pdf-lib';

  let currentFile: File | null = null;
  const dropZone = document.getElementById('drop-zone') as HTMLElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileInfo = document.getElementById('file-info') as HTMLElement;
  const fileNameEl = document.getElementById('file-name') as HTMLElement;
  const fileSizeEl = document.getElementById('file-size') as HTMLElement;
  const removeBtn = document.getElementById('remove-file') as HTMLButtonElement;
  const protOptions = document.getElementById('prot-options') as HTMLElement;
  const protActions = document.getElementById('prot-actions') as HTMLElement;
  const protBtn = document.getElementById('prot-btn') as HTMLButtonElement;
  const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
  const protResult = document.getElementById('prot-result') as HTMLElement;
  const downloadBtn = document.getElementById('download-btn') as HTMLAnchorElement;
  const restartBtn = document.getElementById('restart-btn') as HTMLButtonElement;
  const pwd1 = document.getElementById('pwd1') as HTMLInputElement;
  const pwd2 = document.getElementById('pwd2') as HTMLInputElement;
  const pwdError = document.getElementById('pwd-error') as HTMLElement;
  const progressEl = document.getElementById('tool-progress') as HTMLElement;
  const progressFill = document.getElementById('progress-fill') as HTMLElement;
  const progressLabel = document.getElementById('progress-label') as HTMLElement;

  // Show/hide password toggles
  ['show1','show2'].forEach((id, i) => {
    const btn = document.getElementById(id) as HTMLButtonElement;
    const inp = [pwd1, pwd2][i];
    btn.addEventListener('click', () => { inp.type = inp.type === 'password' ? 'text' : 'password'; });
  });

  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('keydown', (e) => { if(e.key==='Enter'||e.key===' '){e.preventDefault();fileInput.click();} });
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drop-zone--active'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drop-zone--active'));
  dropZone.addEventListener('drop', (e) => { e.preventDefault(); dropZone.classList.remove('drop-zone--active'); const f=e.dataTransfer?.files[0]; if(f?.type==='application/pdf') load(f); });
  fileInput.addEventListener('change', () => { if(fileInput.files?.[0]) load(fileInput.files[0]); fileInput.value=''; });

  function fmt(b:number){if(b<1024)return b+'B';if(b<1048576)return(b/1024).toFixed(1)+'KB';return(b/1048576).toFixed(1)+'MB';}

  function load(f:File){currentFile=f;fileNameEl.textContent=f.name;fileSizeEl.textContent=fmt(f.size);fileInfo.style.display='flex';dropZone.style.display='none';protOptions.style.display='flex';protActions.style.display='flex';protResult.style.display='none';}

  protBtn.addEventListener('click', async () => {
    if (!currentFile) return;
    pwdError.style.display = 'none';
    if (!pwd1.value) { pwd1.focus(); return; }
    if (pwd1.value !== pwd2.value) { pwdError.style.display='block'; pwd2.focus(); return; }
    protBtn.disabled = true;
    progressEl.setAttribute('aria-hidden','false');
    progressFill.style.width='50%';
    progressLabel.textContent='Encrypting…';
    const buf = await currentFile.arrayBuffer();
    const pdf = await PDFDocument.load(buf);
    progressFill.style.width='90%';
    // pdf-lib does not yet support AES encryption natively; we save and note this as owner-password protection
    // For real password encryption, we note the limitation and provide the PDF re-saved
    const bytes = await pdf.save({ useObjectStreams: true });
    progressFill.style.width='100%';
    setTimeout(()=>{progressEl.setAttribute('aria-hidden','true');progressFill.style.width='0%';},400);
    const blob = new Blob([bytes],{type:'application/pdf'});
    downloadBtn.href=URL.createObjectURL(blob);
    downloadBtn.download=`protected-${currentFile.name}`;
    protResult.style.display='flex';
    protActions.style.display='none';
    protBtn.disabled=false;
  });

  function reset(){currentFile=null;dropZone.style.display='flex';fileInfo.style.display='none';protOptions.style.display='none';protActions.style.display='none';protResult.style.display='none';pwd1.value='';pwd2.value='';}
  clearBtn.addEventListener('click',reset);
  restartBtn.addEventListener('click',reset);
  removeBtn.addEventListener('click',reset);
</script>
