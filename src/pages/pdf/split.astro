---
import ToolLayout from '../../layouts/ToolLayout.astro';
import { seoDataPdf } from '../../data/seo-pdf';

const howToSteps = [
  { name: "Upload your PDF", text: "Drop or browse to select the PDF you want to split. Any PDF up to any size works — no file limit." },
  { name: "Choose split mode", text: "Pick 'Visual Selection' to select pages by clicking them, 'By Page Range' to extract specific pages (e.g. 1-3, 5, 7-9), or 'Extract All Pages'." },
  { name: "Split and Download", text: "Choose to extract into a single new PDF or multiple PDFs. Click 'Split PDF'. Your browser splits the file instantly using WebAssembly." },
];

---

<ToolLayout
  title="Split PDF Free Online — Extract Pages by Range or Visually, No Sign-Up"
  description="Split a PDF into separate files by page range, visually select pages, or extract all pages individually. Free, private, instant — runs entirely in your browser."
  canonicalPath="/pdf/split"
  toolName="Split PDF"
  toolTagline="Extract any pages from a PDF visually or by range. Create single or multiple PDFs. Free & private."
  category="pdf"
  categoryLabel="PDF Tools"
  categoryHref="/#category-pdf"
  acceptedFormats="One PDF file · No size limit · Files stay on your device"
  howToSteps={howToSteps}
  keywords={seoDataPdf["split"].keywords}
  faqs={seoDataPdf["split"].faqs}
>

  <div slot="drop-zone">
    <div class="drop-zone" id="drop-zone" role="button" tabindex="0" aria-label="Drop a PDF file here or click to browse">
      <svg class="drop-zone__icon" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="17 8 12 3 7 8"/>
        <line x1="12" y1="3" x2="12" y2="15"/>
      </svg>
      <span class="drop-zone__text">Drop a PDF file here or click to browse</span>
      <span class="drop-zone__hint">One PDF · No size limit · Files stay on your device</span>
      <input type="file" id="file-input" accept=".pdf,application/pdf" class="sr-only" aria-label="Select PDF file" />
    </div>
  </div>

  <div slot="file-list">
    <div class="split-file-info" id="file-info" style="display:none;">
      <div class="split-file-info__row">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand-primary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
        <span id="file-name" class="split-file-info__name"></span>
        <span id="file-meta" class="split-file-info__meta"></span>
        <button class="file-item__remove" id="remove-file" aria-label="Remove file">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div slot="options">
    <div class="split-options" id="split-options" style="display:none;">
      
      <p class="overline-text" style="margin-bottom:var(--space-3);">Split Mode</p>
      <div class="split-mode-group" role="radiogroup" aria-label="Split mode">
        <label class="split-mode-option split-mode-option--active" id="mode-visual-label">
          <input type="radio" name="split-mode" value="visual" checked class="sr-only" />
          <div class="split-mode-option__dot"></div>
          <div>
            <span class="split-mode-option__title">Visual Selection</span>
            <span class="split-mode-option__desc">Click pages to select/deselect them</span>
          </div>
        </label>
        <label class="split-mode-option" id="mode-range-label">
          <input type="radio" name="split-mode" value="range" class="sr-only" />
          <div class="split-mode-option__dot"></div>
          <div>
            <span class="split-mode-option__title">By Page Range</span>
            <span class="split-mode-option__desc">e.g. 1-3, 5, 7-9</span>
          </div>
        </label>
        <label class="split-mode-option" id="mode-all-label">
          <input type="radio" name="split-mode" value="all" class="sr-only" />
          <div class="split-mode-option__dot"></div>
          <div>
            <span class="split-mode-option__title">Extract All Pages</span>
            <span class="split-mode-option__desc">Select every page</span>
          </div>
        </label>
      </div>

      <div id="loading-msg" style="display:none;" class="split-loading">
        <div class="skeleton" style="height:80px;width:100%;"></div>
        <p class="caption-text" style="margin-top:var(--space-2);">Rendering page thumbnails…</p>
      </div>

      <div class="split-visual-grid" id="visual-grid"></div>

      <div class="split-range-input" id="range-input-wrapper" style="display:none;">
        <label for="page-range" class="split-range-label">Page ranges <span class="split-range-hint">(e.g. 1-3, 5, 8-10)</span></label>
        <input type="text" id="page-range" class="input" placeholder="1-3, 5, 8-10" aria-describedby="range-hint" />
        <p class="caption-text" id="range-hint" style="margin-top:var(--space-1);">Separate ranges with commas. Use hyphens for ranges.</p>
      </div>

      <div class="split-output-group" style="margin-top:var(--space-5);">
        <p class="overline-text" style="margin-bottom:var(--space-3);">Output Format</p>
        <div class="ti-radio-group">
          <label class="ti-radio"><input type="radio" name="output-mode" value="single" checked /> Merge selected into ONE file</label>
          <label class="ti-radio"><input type="radio" name="output-mode" value="multiple" /> Create MULTIPLE files</label>
        </div>
      </div>
    </div>
  </div>

  <div slot="actions" class="split-actions" id="split-actions" style="display:none;">
    <button class="btn btn-primary btn-lg" id="split-btn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5M4 20L21 3M21 16v5h-5M15 15l5.1 5.1M4 4l5 5"/></svg>
      Split PDF
    </button>
    <button class="btn btn-ghost" id="clear-btn">Clear</button>
  </div>

  <div slot="result">
    <div class="split-results" id="split-results" style="display:none;" aria-live="assertive">
      <p class="split-results__label">Split complete — <span id="results-count"></span></p>
      <div class="split-results__list" id="results-list"></div>
      <button class="btn btn-ghost btn-sm" id="restart-btn" style="margin-top:var(--space-2);">Split another file</button>
    </div>
  </div>

</ToolLayout>

<style is:global>
  .split-file-info { background: var(--theme-alpha-04); border: 1px solid var(--theme-alpha-15); border-radius: var(--radius-md); padding: var(--space-3) var(--space-4); margin-bottom: var(--space-4); }
  .split-file-info__row { display: flex; align-items: center; gap: var(--space-3); }
  .split-file-info__name { flex: 1; font-size: .9375rem; font-weight: 500; color: var(--color-ink-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .split-file-info__meta { font-size: .8125rem; color: var(--color-ink-faint); white-space: nowrap; }

  .split-mode-group { display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-5); }
  .split-mode-option { display: flex; align-items: flex-start; gap: var(--space-3); padding: var(--space-4); border: 1.5px solid var(--color-border-hairline); border-radius: var(--radius-md); cursor: pointer; transition: border-color var(--duration-fast) var(--ease-out); }
  .split-mode-option--active { border-color: var(--color-ink-primary); background: var(--color-canvas-soft); }
  .split-mode-option__dot { width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--color-border-subtle); flex-shrink: 0; margin-top: 2px; transition: border-color var(--duration-fast), background var(--duration-fast); }
  .split-mode-option--active .split-mode-option__dot { border-color: var(--color-ink-primary); background: var(--color-ink-primary); }
  .split-mode-option__title { display: block; font-size: .9375rem; font-weight: 600; color: var(--color-ink-primary); }
  .split-mode-option__desc { font-size: .8125rem; color: var(--color-ink-muted); }

  .split-range-input { display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-4); }
  .split-range-label { font-size: .9375rem; font-weight: 500; color: var(--color-ink-primary); }
  .split-range-hint { font-weight: 400; color: var(--color-ink-faint); }

  .split-visual-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: var(--space-3); margin-bottom: var(--space-4); }
  .split-visual-grid:empty { display: none; }
  .split-page { position: relative; cursor: pointer; user-select: none; border-radius: var(--radius-sm); border: 2px solid transparent; transition: all var(--duration-fast); padding: 4px; }
  .split-page:hover { border-color: rgba(207, 69, 0, 0.4); background: rgba(207, 69, 0, 0.02); }
  .split-page--selected { border-color: var(--color-brand-primary); background: var(--theme-alpha-08); }
  .split-thumb { width: 100%; aspect-ratio: 3/4; background: #fff; border: 1px solid var(--color-border-hairline); border-radius: 4px; display: flex; align-items: center; justify-content: center; overflow: hidden; box-shadow: var(--shadow-sm); }
  .split-page-num { display: block; text-align: center; font-size: 0.75rem; font-weight: 600; margin-top: 6px; color: var(--color-ink-muted); }
  .split-page--selected .split-page-num { color: var(--color-brand-primary); }
  .split-page--selected .split-thumb { border-color: var(--color-brand-primary); box-shadow: 0 0 0 2px var(--theme-alpha-20); }
  
  .split-loading { margin-bottom: var(--space-4); }
  
  .ti-radio-group { display: flex; flex-direction: column; gap: var(--space-3); }
  .ti-radio { display: flex; align-items: center; gap: var(--space-2); font-size: 0.9375rem; color: var(--color-ink-secondary); cursor: pointer; }

  .split-actions { display: flex; align-items: center; gap: var(--space-4); }
  
  .split-results__label { font-size: 1rem; font-weight: 600; color: var(--color-ink-primary); margin-bottom: var(--space-4); }
  .split-results__list { display: flex; flex-direction: column; gap: var(--space-2); }
  .split-result-item { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-4); background: var(--color-success-bg); border: 1px solid rgba(15,123,63,.15); border-radius: var(--radius-md); }
  .split-result-item__name { flex: 1; font-size: .9rem; font-weight: 500; color: var(--color-ink-primary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .split-result-item__size { font-size: .8125rem; color: var(--color-ink-muted); white-space: nowrap; }
</style>

<script>
  import { PDFDocument } from 'pdf-lib';
  import { loadPdfJs, getPdfDoc, renderPageToCanvas } from '../../utils/pdfRender';

  interface PageData { index: number; dataUrl?: string; selected: boolean; }
  let currentFile: File | null = null;
  let pages: PageData[] = [];
  let totalPages = 0;

  const dropZone = document.getElementById('drop-zone') as HTMLElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileInfo = document.getElementById('file-info') as HTMLElement;
  const fileName = document.getElementById('file-name') as HTMLElement;
  const fileMeta = document.getElementById('file-meta') as HTMLElement;
  const removeBtn = document.getElementById('remove-file') as HTMLButtonElement;
  const splitOptions = document.getElementById('split-options') as HTMLElement;
  const splitActions = document.getElementById('split-actions') as HTMLElement;
  const splitBtn = document.getElementById('split-btn') as HTMLButtonElement;
  const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
  const splitResults = document.getElementById('split-results') as HTMLElement;
  const resultsList = document.getElementById('results-list') as HTMLElement;
  const resultsCount = document.getElementById('results-count') as HTMLElement;
  const restartBtn = document.getElementById('restart-btn') as HTMLButtonElement;
  
  const loadingMsg = document.getElementById('loading-msg') as HTMLElement;
  const visualGrid = document.getElementById('visual-grid') as HTMLElement;
  const rangeWrapper = document.getElementById('range-input-wrapper') as HTMLElement;
  const pageRangeInput = document.getElementById('page-range') as HTMLInputElement;
  
  const progressEl = document.getElementById('tool-progress') as HTMLElement;
  const progressFill = document.getElementById('progress-fill') as HTMLElement;
  const progressLabel = document.getElementById('progress-label') as HTMLElement;

  // Upload
  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); fileInput.click(); } });
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drop-zone--active'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drop-zone--active'));
  dropZone.addEventListener('drop', (e) => { e.preventDefault(); dropZone.classList.remove('drop-zone--active'); const f = e.dataTransfer?.files[0]; if (f?.type === 'application/pdf') loadFile(f); });
  fileInput.addEventListener('change', () => { if (fileInput.files?.[0]) loadFile(fileInput.files[0]); fileInput.value = ''; });

  async function loadFile(file: File) {
    currentFile = file;
    fileName.textContent = file.name;
    fileInfo.style.display = 'block';
    dropZone.style.display = 'none';
    splitOptions.style.display = 'block';
    splitActions.style.display = 'flex';
    splitResults.style.display = 'none';
    loadingMsg.style.display = 'flex';
    
    const buf = await file.arrayBuffer();
    
    try {
      const pdfjs = await loadPdfJs();
      const pdfDoc = await getPdfDoc(pdfjs, buf);
      totalPages = pdfDoc.numPages;
      fileMeta.textContent = `${totalPages} pages · ${formatSize(file.size)}`;
      
      pages = Array.from({ length: totalPages }, (_, i) => ({ index: i, selected: false }));
      renderVisualGrid();
      
      // Load thumbnails
      for (let i = 0; i < totalPages; i++) {
        const { canvas } = await renderPageToCanvas(pdfDoc, i + 1, 0.6); // Better quality thumbnail
        pages[i].dataUrl = canvas.toDataURL('image/jpeg', 0.8);
        updateThumbnail(i);
      }
    } catch (e) {
      console.error(e);
      (window as any).showToast('Error rendering PDF preview.', 'error');
    } finally {
      loadingMsg.style.display = 'none';
    }
  }

  function renderVisualGrid() {
    visualGrid.innerHTML = '';
    pages.forEach((p, i) => {
      const card = document.createElement('div');
      card.className = `split-page ${p.selected ? 'split-page--selected' : ''}`;
      card.dataset.index = String(i);
      
      const thumbHtml = p.dataUrl 
        ? `<img src="${p.dataUrl}" alt="Page ${i + 1}" style="width:100%;height:100%;object-fit:contain;" />`
        : `<span class="caption-text">Page ${i + 1}</span>`;

      card.innerHTML = `
        <div class="split-thumb">${thumbHtml}</div>
        <span class="split-page-num">${i + 1}</span>
      `;
      
      card.addEventListener('click', () => {
        pages[i].selected = !pages[i].selected;
        if (pages[i].selected) {
          card.classList.add('split-page--selected');
        } else {
          card.classList.remove('split-page--selected');
        }
      });
      
      visualGrid.appendChild(card);
    });
  }

  function updateThumbnail(index: number) {
    const card = document.querySelector(`.split-page[data-index="${index}"]`);
    if (card) {
      const thumb = card.querySelector('.split-thumb') as HTMLElement;
      if (pages[index].dataUrl && thumb) {
        thumb.innerHTML = `<img src="${pages[index].dataUrl}" alt="Page ${index + 1}" style="width:100%;height:100%;object-fit:contain;" />`;
      }
    }
  }

  // Mode toggle
  document.querySelectorAll('input[name="split-mode"]').forEach(radio => {
    radio.addEventListener('change', () => {
      const val = (radio as HTMLInputElement).value;
      document.querySelectorAll('.split-mode-option').forEach(el => el.classList.remove('split-mode-option--active'));
      (radio.closest('.split-mode-option') as HTMLElement)?.classList.add('split-mode-option--active');
      
      if (val === 'range') {
        rangeWrapper.style.display = 'flex';
        visualGrid.style.display = 'none';
      } else if (val === 'visual') {
        rangeWrapper.style.display = 'none';
        visualGrid.style.display = 'grid';
      } else { // all
        rangeWrapper.style.display = 'none';
        visualGrid.style.display = 'none';
      }
    });
  });

  function parseRanges(rangeStr: string, max: number): number[] {
    const indices = new Set<number>();
    const parts = rangeStr.split(',').map(s => s.trim()).filter(Boolean);
    for (const part of parts) {
      if (part.includes('-')) {
        const [a, b] = part.split('-').map(Number);
        if (!isNaN(a) && !isNaN(b) && a >= 1 && b <= max && a <= b) {
          for (let i = a; i <= b; i++) indices.add(i - 1);
        }
      } else {
        const n = Number(part);
        if (!isNaN(n) && n >= 1 && n <= max) indices.add(n - 1);
      }
    }
    return Array.from(indices).sort((a, b) => a - b);
  }

  function formatSize(bytes: number) {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  splitBtn.addEventListener('click', async () => {
    if (!currentFile) return;
    const mode = (document.querySelector('input[name="split-mode"]:checked') as HTMLInputElement).value;
    const outputMode = (document.querySelector('input[name="output-mode"]:checked') as HTMLInputElement).value;
    
    let selectedIndices: number[] = [];
    if (mode === 'all') {
      selectedIndices = Array.from({ length: totalPages }, (_, i) => i);
    } else if (mode === 'range') {
      selectedIndices = parseRanges(pageRangeInput.value, totalPages);
    } else {
      selectedIndices = pages.filter(p => p.selected).map(p => p.index);
    }

    if (selectedIndices.length === 0) { 
      (window as any).showToast('Please select at least one page to extract.', 'error'); 
      return; 
    }

    splitBtn.disabled = true;
    showProgress(10, 'Loading original PDF…');
    resultsList.innerHTML = '';
    
    const buf = await currentFile.arrayBuffer();
    const srcPdf = await PDFDocument.load(buf);
    const outputs: { name: string; blob: Blob; size: number }[] = [];

    if (outputMode === 'single') {
      showProgress(50, 'Extracting pages into a single file…');
      const newPdf = await PDFDocument.create();
      const copiedPages = await newPdf.copyPages(srcPdf, selectedIndices);
      copiedPages.forEach(p => newPdf.addPage(p));
      const bytes = await newPdf.save();
      const baseName = currentFile.name.replace(/\.pdf$/i, '');
      outputs.push({ name: `${baseName}-extracted.pdf`, blob: new Blob([bytes], { type: 'application/pdf' }), size: bytes.byteLength });
    } else {
      // Multiple PDFs
      for (let i = 0; i < selectedIndices.length; i++) {
        showProgress(10 + Math.round((i / selectedIndices.length) * 80), `Extracting page ${selectedIndices[i] + 1}…`);
        const newPdf = await PDFDocument.create();
        const [copiedPage] = await newPdf.copyPages(srcPdf, [selectedIndices[i]]);
        newPdf.addPage(copiedPage);
        const bytes = await newPdf.save();
        const baseName = currentFile.name.replace(/\.pdf$/i, '');
        outputs.push({ name: `${baseName}-page${selectedIndices[i] + 1}.pdf`, blob: new Blob([bytes], { type: 'application/pdf' }), size: bytes.byteLength });
      }
    }

    hideProgress();
    resultsCount.textContent = `${outputs.length} PDF${outputs.length > 1 ? 's' : ''} ready`;

    outputs.forEach(out => {
      const url = URL.createObjectURL(out.blob);
      const div = document.createElement('div');
      div.className = 'split-result-item';
      div.innerHTML = `
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent-green)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <span class="split-result-item__name">${out.name}</span>
        <span class="split-result-item__size">${formatSize(out.size)}</span>
        <a class="btn btn-sm btn-secondary" href="${url}" download="${out.name}">Download</a>
      `;
      resultsList.appendChild(div);
    });

    splitResults.style.display = 'block';
    splitActions.style.display = 'none';
    splitBtn.disabled = false;
  });

  function reset() { currentFile = null; totalPages = 0; dropZone.style.display = 'flex'; fileInfo.style.display = 'none'; splitOptions.style.display = 'none'; splitActions.style.display = 'none'; splitResults.style.display = 'none'; pageRangeInput.value = ''; }
  clearBtn.addEventListener('click', reset);
  restartBtn.addEventListener('click', reset);
  removeBtn.addEventListener('click', reset);

  function showProgress(pct: number, label: string) { progressEl.setAttribute('aria-hidden', 'false'); progressFill.style.width = `${pct}%`; progressLabel.textContent = label; }
  function hideProgress() { setTimeout(() => { progressEl.setAttribute('aria-hidden', 'true'); progressFill.style.width = '0%'; }, 400); }
</script>
