---
import ToolLayout from '../../layouts/ToolLayout.astro';
const howToSteps = [
  { name: "Upload your PDF", text: "Drop or select the PDF you want to convert to Word (.docx). Works best on text-based PDFs." },
  { name: "Click Convert", text: "The tool extracts all text content from your PDF and structures it into a Word-compatible document." },
  { name: "Download your .docx", text: "Download the .docx file. Open in Microsoft Word, Google Docs, or LibreOffice and edit freely." },
];
const faqs = [
  { question: "Will the formatting be exactly preserved?", answer: "Text content is faithfully extracted. Complex layouts with tables, columns, and graphics may be simplified — PDF-to-Word conversion has inherent limitations due to the format differences. For best results, use on text-heavy PDFs." },
  { question: "Is my file uploaded to a server?", answer: "No. Conversion runs in your browser using pdf-lib and docx.js. Your file never leaves your device." },
  { question: "What about scanned PDFs?", answer: "Scanned PDFs contain image data rather than text. Use our OCR (Extract Text) tool first to extract the text, then paste it into a Word document." },
];
---

<ToolLayout
  title="PDF to Word Converter — Free Online, No Sign-Up Required"
  description="Convert PDF files to editable Word (.docx) documents. Free, private, instant — runs entirely in your browser. No sign-up or watermarks."
  canonicalPath="/pdf/to-word"
  toolName="PDF to Word"
  toolTagline="Convert your PDF to an editable Word document — free, private, instant."
  category="pdf"
  categoryLabel="PDF Tools"
  categoryHref="/#category-pdf"
  acceptedFormats="Text-based PDF · No size limit"
  howToSteps={howToSteps}
  faqs={faqs}
>
  <div slot="drop-zone">
    <div class="drop-zone" id="drop-zone" role="button" tabindex="0" aria-label="Drop a PDF here or click to browse">
      <svg class="drop-zone__icon" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
      <span class="drop-zone__text">Drop a PDF here or click to browse</span>
      <span class="drop-zone__hint">Text-based PDF recommended · No size limit · Files stay on your device</span>
      <input type="file" id="file-input" accept=".pdf,application/pdf" class="sr-only" />
    </div>
  </div>
  <div slot="file-list">
    <div id="file-info" style="display:none;" class="tw-file-info">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand-primary)" stroke-width="2" stroke-linecap="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
      <span id="file-name" class="tw-file-name"></span>
      <span id="file-size" class="tw-file-size"></span>
      <button class="file-item__remove" id="remove-file"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
    </div>
  </div>
  <div slot="actions" style="display:none;" id="tw-actions" class="tw-actions">
    <button class="btn btn-primary btn-lg" id="convert-btn">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
      Convert to Word
    </button>
    <button class="btn btn-ghost" id="clear-btn">Clear</button>
  </div>
  <div slot="result">
    <div id="tw-result" style="display:none;" class="tw-result" aria-live="assertive">
      <div class="tw-result__icon"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="20 6 9 17 4 12"/></svg></div>
      <div><p class="tw-result__label">Conversion complete!</p><p class="tw-result__sub" id="page-count-text"></p></div>
      <a class="btn btn-accent" id="download-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Download .docx
      </a>
      <button class="btn btn-ghost btn-sm" id="restart-btn">Convert another</button>
    </div>
  </div>
</ToolLayout>

<style is:global>
  .tw-file-info{display:flex;align-items:center;gap:var(--space-3);padding:var(--space-3) var(--space-4);background:var(--theme-alpha-04);border:1px solid var(--theme-alpha-15);border-radius:var(--radius-md);}
  .tw-file-name{flex:1;font-size:.9375rem;font-weight:500;color:var(--color-ink-primary);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .tw-file-size{font-size:.8125rem;color:var(--color-ink-faint);white-space:nowrap;}
  .tw-actions{display:flex;align-items:center;gap:var(--space-4);}
  .tw-result{display:flex;align-items:center;gap:var(--space-5);padding:var(--space-5) var(--space-6);background:var(--color-success-bg);border:1px solid rgba(15,123,63,.2);border-radius:var(--radius-lg);flex-wrap:wrap;animation:fade-in-up var(--duration-slow) var(--ease-out);}
  .tw-result__icon{width:52px;height:52px;border-radius:var(--radius-pill);background:var(--color-accent-green);color:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .tw-result__label{font-size:1rem;font-weight:600;color:var(--color-accent-green);}
  .tw-result__sub{font-size:.8125rem;color:var(--color-ink-muted);margin-top:2px;}
</style>

<script>
  import { PDFDocument } from 'pdf-lib';

  let currentFile: File | null = null;
  const dropZone = document.getElementById('drop-zone') as HTMLElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const fileInfo = document.getElementById('file-info') as HTMLElement;
  const fileNameEl = document.getElementById('file-name') as HTMLElement;
  const fileSizeEl = document.getElementById('file-size') as HTMLElement;
  const removeBtn = document.getElementById('remove-file') as HTMLButtonElement;
  const twActions = document.getElementById('tw-actions') as HTMLElement;
  const convertBtn = document.getElementById('convert-btn') as HTMLButtonElement;
  const clearBtn = document.getElementById('clear-btn') as HTMLButtonElement;
  const twResult = document.getElementById('tw-result') as HTMLElement;
  const downloadBtn = document.getElementById('download-btn') as HTMLAnchorElement;
  const restartBtn = document.getElementById('restart-btn') as HTMLButtonElement;
  const pageCountText = document.getElementById('page-count-text') as HTMLElement;
  const progressEl = document.getElementById('tool-progress') as HTMLElement;
  const progressFill = document.getElementById('progress-fill') as HTMLElement;
  const progressLabel = document.getElementById('progress-label') as HTMLElement;

  function fmt(b:number){if(b<1048576)return(b/1024).toFixed(1)+'KB';return(b/1048576).toFixed(1)+'MB';}

  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('keydown', (e) => { if(e.key==='Enter'||e.key===' '){e.preventDefault();fileInput.click();} });
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drop-zone--active'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drop-zone--active'));
  dropZone.addEventListener('drop', (e) => { e.preventDefault(); dropZone.classList.remove('drop-zone--active'); const f=e.dataTransfer?.files[0]; if(f?.type==='application/pdf') load(f); });
  fileInput.addEventListener('change', () => { if(fileInput.files?.[0]) load(fileInput.files[0]); fileInput.value=''; });

  function load(f:File){currentFile=f;fileNameEl.textContent=f.name;fileSizeEl.textContent=fmt(f.size);fileInfo.style.display='flex';dropZone.style.display='none';twActions.style.display='flex';twResult.style.display='none';}

  convertBtn.addEventListener('click', async () => {
    if (!currentFile) return;
    convertBtn.disabled = true;
    progressEl.setAttribute('aria-hidden','false');
    progressFill.style.width = '30%';
    progressLabel.textContent = 'Extracting text from PDF…';

    const buf = await currentFile.arrayBuffer();
    
    progressFill.style.width = '40%';
    progressLabel.textContent = 'Loading PDF Engine…';
    
    const pdfjsLib = await import('pdfjs-dist');
    pdfjsLib.GlobalWorkerOptions.workerSrc = `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${pdfjsLib.version}/pdf.worker.min.mjs`;
    const loadingTask = pdfjsLib.getDocument({ 
      data: buf.slice(0),
      cMapUrl: `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${pdfjsLib.version}/cmaps/`,
      cMapPacked: true,
      standardFontDataUrl: `https://cdnjs.cloudflare.com/ajax/libs/pdf.js/${pdfjsLib.version}/standard_fonts/`
    });
    const pdfDoc = await loadingTask.promise;
    const numPages = pdfDoc.numPages;

    progressFill.style.width = '60%';
    progressLabel.textContent = 'Extracting Text & Building Word document…';

    const { Document, Packer, Paragraph, TextRun, HeadingLevel } = await import('docx');

    const paragraphs: Paragraph[] = [];
    
    paragraphs.push(new Paragraph({
      text: currentFile.name.replace(/\.pdf$/i, ''),
      heading: HeadingLevel.TITLE,
    }));
    paragraphs.push(new Paragraph({ text: '' }));

    for (let i = 1; i <= numPages; i++) {
      paragraphs.push(new Paragraph({
        text: `— Page ${i} —`,
        heading: HeadingLevel.HEADING_2,
      }));

      const page = await pdfDoc.getPage(i);
      const textContent = await page.getTextContent();
      
      let pageText = '';
      let lastY = -1;
      
      for (const item of textContent.items as any[]) {
        if (lastY !== -1 && Math.abs(item.transform[5] - lastY) > 5) {
           pageText += '\n';
        }
        pageText += item.str || '';
        if (item.hasEOL) {
           pageText += '\n';
        }
        lastY = item.transform[5];
      }
      
      const lines = pageText.split('\n').map(l => l.trim()).filter(l => l.length > 0);

      if (lines.length > 0) {
        for (const line of lines) {
          paragraphs.push(new Paragraph({ children: [new TextRun({ text: line, size: 24 })] }));
        }
      } else {
        paragraphs.push(new Paragraph({
          children: [new TextRun({ text: '[This page appears to contain only images or is a scanned document. Use OCR for image-based PDFs.]', color: '888888', size: 20, italics: true })]
        }));
      }
      paragraphs.push(new Paragraph({ text: '' }));
    }

    progressFill.style.width = '85%';
    progressLabel.textContent = 'Packaging .docx file…';

    const doc = new Document({ sections: [{ properties: {}, children: paragraphs }] });
    const blob = await Packer.toBlob(doc);

    progressFill.style.width = '100%';
    setTimeout(()=>{progressEl.setAttribute('aria-hidden','true');progressFill.style.width='0%';},400);

    downloadBtn.href = URL.createObjectURL(blob);
    downloadBtn.download = currentFile.name.replace(/\.pdf$/i,'') + '.docx';
    pageCountText.textContent = `${numPages} page${numPages!==1?'s':''} converted`;
    twResult.style.display = 'flex';
    twActions.style.display = 'none';
    convertBtn.disabled = false;
  });

  function reset(){currentFile=null;dropZone.style.display='flex';fileInfo.style.display='none';twActions.style.display='none';twResult.style.display='none';}
  clearBtn.addEventListener('click',reset);
  restartBtn.addEventListener('click',reset);
  removeBtn.addEventListener('click',reset);
</script>
