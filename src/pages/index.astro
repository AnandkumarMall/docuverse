---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="DocuVerse" description="Free online PDF & image tools. 100% private — your files never leave your browser.">

<div class="container section">
  <h1 class="display-hero">DocuVerse</h1>
  <p class="body-large" style="margin-top: var(--space-4); max-width: 520px;">
    Free online document & image tools. 100% private — your files never leave your browser.
  </p>

  <div style="margin-top: var(--space-10); display: flex; flex-wrap: wrap; gap: var(--space-3);">
    <button class="btn btn-primary">Merge PDF</button>
    <button class="btn btn-secondary">Split PDF</button>
    <button class="btn btn-accent">Compress Image</button>
    <button class="btn btn-ghost">Learn More</button>
  </div>

  <div style="margin-top: var(--space-8); display: flex; flex-wrap: wrap; gap: var(--space-3);">
    <button class="btn btn-primary btn-sm">Small Primary</button>
    <button class="btn btn-primary btn-lg">Large Primary</button>
    <button class="btn btn-primary" disabled>Disabled</button>
  </div>

  <h2 class="heading-section" style="margin-top: var(--space-16);">Typography Scale</h2>
  <p class="body-text" style="margin-top: var(--space-3);">
    Body text using Inter — crisp, readable, distraction-free.
  </p>
  <p class="caption-text" style="margin-top: var(--space-2);">
    Caption text for metadata, hints, and secondary info.
  </p>
  <p class="overline-text" style="margin-top: var(--space-4);">PDF TOOLS</p>

  <h2 class="heading-section" style="margin-top: var(--space-16);">Tool Cards</h2>
  <div class="tool-grid" style="margin-top: var(--space-6);">
    <div class="tool-card tool-card--pdf">
      <div class="tool-card__icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/></svg>
      </div>
      <span class="tool-card__title">Merge PDF</span>
      <span class="tool-card__description">Combine multiple PDF files into one document. Drag and drop to reorder pages.</span>
    </div>

    <div class="tool-card tool-card--image">
      <div class="tool-card__icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
      </div>
      <span class="tool-card__title">Crop Image</span>
      <span class="tool-card__description">Interactive crop with presets for Instagram, TikTok, and custom aspect ratios.</span>
    </div>

    <div class="tool-card tool-card--utility">
      <div class="tool-card__icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/></svg>
      </div>
      <span class="tool-card__title">Extract Text (OCR)</span>
      <span class="tool-card__description">Pull text from images and scanned documents. Supports English and Hindi.</span>
    </div>
  </div>

  <h2 class="heading-section" style="margin-top: var(--space-16);">Drop Zone</h2>
  <div class="drop-zone" style="margin-top: var(--space-6);">
    <svg class="drop-zone__icon" xmlns="http://www.w3.org/2000/svg" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
    <span class="drop-zone__text">Drop your PDF files here or click to browse</span>
    <span class="drop-zone__hint">Supports PDF, up to 100 MB per file</span>
  </div>

  <h2 class="heading-section" style="margin-top: var(--space-16);">Badges</h2>
  <div style="margin-top: var(--space-6); display: flex; flex-wrap: wrap; gap: var(--space-3);">
    <span class="badge badge-neutral">PDF</span>
    <span class="badge badge-success">Complete</span>
    <span class="badge badge-warning">Processing</span>
    <span class="badge badge-error">Failed</span>
    <span class="badge badge-info">New</span>
  </div>

  <div style="margin-top: var(--space-8);">
    <span class="trust-badge">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      100% Private — Files never leave your browser
    </span>
  </div>

  <h2 class="heading-section" style="margin-top: var(--space-16);">Form Input</h2>
  <div style="margin-top: var(--space-6); max-width: 400px;">
    <input class="input input-search" type="text" placeholder="Search tools..." />
  </div>

  <h2 class="heading-section" style="margin-top: var(--space-16);">Progress Bar</h2>
  <div style="margin-top: var(--space-6); max-width: 400px;">
    <div class="progress-bar">
      <div class="progress-bar__fill" style="width: 65%;"></div>
    </div>
  </div>

  <h2 class="heading-section" style="margin-top: var(--space-16);">File Item</h2>
  <div style="margin-top: var(--space-6); max-width: 500px; display: flex; flex-direction: column; gap: var(--space-2);">
    <div class="file-item">
      <span class="file-item__name">report-q3-2024.pdf</span>
      <span class="file-item__size">2.4 MB</span>
      <button class="file-item__remove" aria-label="Remove file">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="file-item">
      <span class="file-item__name">photo-vacation-beach.jpg</span>
      <span class="file-item__size">4.1 MB</span>
      <button class="file-item__remove" aria-label="Remove file">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <h2 class="heading-section" style="margin-top: var(--space-16);">Skeleton Loader</h2>
  <div style="margin-top: var(--space-6); max-width: 400px; display: flex; flex-direction: column; gap: var(--space-3);">
    <div class="skeleton" style="height: 20px; width: 60%;"></div>
    <div class="skeleton" style="height: 16px; width: 100%;"></div>
    <div class="skeleton" style="height: 16px; width: 80%;"></div>
  </div>
</div>

</BaseLayout>
