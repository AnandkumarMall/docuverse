---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAssetPath } from '../utils/paths';
---

<BaseLayout title="Page Not Found | DocuVerse" noIndex={true}>
  <div class="error-page">
    <div class="error-page__content">
      <div class="error-page__icon">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      </div>
      <h1 class="error-page__title">404</h1>
      <h2 class="error-page__subtitle">Page not found</h2>
      <p class="error-page__desc">The page you're looking for doesn't exist or has been moved.</p>
      
      <div class="error-page__actions">
        <a href={getAssetPath("/")} class="btn btn-primary btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Go to Homepage
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-page {
    min-height: calc(100vh - 160px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-8) var(--space-4);
    background: radial-gradient(circle at center, var(--color-canvas-soft) 0%, var(--color-canvas-base) 100%);
  }
  .error-page__content {
    text-align: center;
    max-width: 480px;
    animation: fade-in-up var(--duration-normal) var(--ease-out);
  }
  .error-page__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 96px;
    height: 96px;
    background: rgba(207, 69, 0, 0.08);
    color: var(--color-accent-orange);
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-6);
  }
  .error-page__title {
    font-size: 5rem;
    font-weight: 900;
    line-height: 1;
    color: var(--color-ink-primary);
    margin-bottom: var(--space-2);
    letter-spacing: -0.04em;
  }
  .error-page__subtitle {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-ink-secondary);
    margin-bottom: var(--space-4);
  }
  .error-page__desc {
    font-size: 1.125rem;
    color: var(--color-ink-muted);
    margin-bottom: var(--space-8);
    line-height: 1.6;
  }
  .error-page__actions {
    display: flex;
    justify-content: center;
  }
</style>
